*==============================================================================*
* ch13_claims.do  --  Chapter 13: an evidence ledger that anchors every claim
* (a) the analysis saves every number it will report, under a claim id
* (b) the ledger: each number as the prose states it, checked against (a)
* (c) the report reads its numbers from a file Stata writes
* (d) references: each claimed title checked against its DOI's record
* Data: nlsw88, shipped with Stata. Part (d) needs internet access and skips
* itself, with a message, when the DOI service cannot be reached.
*==============================================================================*
version 19
clear all
global root "`c(pwd)'"

*--- (a) The analysis saves the numbers it will report -------------------------*
sysuse nlsw88, clear
tempname h
postfile `h' str12 id double value using "$root/claims_values.dta", replace
quietly count
post `h' ("N_workers") (r(N))
quietly summarize wage
post `h' ("wage_mean") (r(mean))
quietly summarize union
post `h' ("union_share") (r(mean))
quietly regress wage grade tenure
post `h' ("b_grade") (_b[grade])
post `h' ("b_tenure") (_b[tenure])
postclose `h'

*--- (b) The ledger: one row per number the prose states ----------------------*
* Typed exactly as the draft states it. Row 4 carries a dropped digit that
* still reads as plausible in a sentence: 0.07 for a grade coefficient of 0.70.
clear
input str12 id double claimed double tol str40 where
"N_workers"   2246   0     "para 2"
"wage_mean"   7.77   0.005 "para 2"
"union_share" 0.25   0.005 "para 3"
"b_grade"     0.07   0.005 "para 3"
"b_tenure"    0.15   0.005 "para 3"
end
save "$root/claims_ledger.dta", replace

capture program drop checkledger
program define checkledger
    args ledger values
    use "`ledger'", clear
    merge 1:1 id using "`values'", keep(master match)
    assert _merge == 3        // every claim has a computed source
    gen double gap = abs(claimed - value)
    gen str4 status = cond(gap <= tol, "ok", "FAIL")
    format value gap %9.4f
    list id claimed value status where, noobs abbreviate(12)
    quietly count if status == "FAIL"
    display as result "LEDGER CHECK: " r(N) " of " _N " claims fail"
end

checkledger "$root/claims_ledger.dta" "$root/claims_values.dta"
quietly count if status == "FAIL"
assert r(N) == 1              // the seeded dropped digit is caught

* Fix the prose and the ledger together, then rerun the check.
use "$root/claims_ledger.dta", clear
replace claimed = 0.70 if id == "b_grade"
save "$root/claims_ledger.dta", replace
checkledger "$root/claims_ledger.dta" "$root/claims_values.dta"
assert status == "ok"
display as result "LEDGER CHECK PASSED"

*--- (c) The report reads its numbers from a file Stata writes ----------------*
use "$root/claims_values.dta", clear
file open nums using "$root/numbers.tex", write replace text
forvalues i = 1/`=_N' {
    local name = subinstr(id[`i'], "_", "", .)
    local fmt  = cond(id[`i'] == "N_workers", "%9.0fc", "%9.2f")
    local val  = strtrim(string(value[`i'], "`fmt'"))
    file write nums "\newcommand{\num`name'}{`val'}" _n
}
file close nums
type "$root/numbers.tex"

*--- (d) References: does the DOI's record carry the claimed title? -----------*
clear
input str20 key str40 doi str110 claimed_title
"walters2023" "10.1038/s41598-023-41032-5" "Fabrication and errors in the bibliographic citations generated by ChatGPT"
"ouyang2025"  "10.1145/3697010"            "An empirical study of the non-determinism of ChatGPT in code generation"
"invented"    "10.1145/3697010"            "Deterministic code generation with large language models"
end
gen str10 check = ""
forvalues i = 1/`=_N' {
    local doi = doi[`i']
    capture copy "https://api.crossref.org/works/`doi'/transform/application/x-bibtex" ///
        "$root/ref`i'.bib", replace
    if _rc {
        replace check = "unreached" in `i'
        continue
    }
    local rec   = lower(ustrregexra(fileread("$root/ref`i'.bib"), "[^A-Za-z0-9]", ""))
    local claim = lower(ustrregexra(claimed_title[`i'], "[^A-Za-z0-9]", ""))
    replace check = cond(strpos(`"`rec'"', `"`claim'"') > 0, "match", "MISMATCH") in `i'
}
list key doi check, noobs
quietly count if check == "unreached"
if r(N) == 0 {
    assert check == "MISMATCH" if key == "invented"
    assert check == "match"    if key != "invented"
    display as result "REFERENCE CHECK: the invented title was caught"
}
else display as text "REFERENCE CHECK skipped for rows the DOI service did not answer"

display "DONE"
