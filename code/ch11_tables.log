. *--- (c) Write a booktabs-FREE LaTeX fragment the book -\input-s --------------*
. * -esttab- writes the .tex; the book ingests exactly what this line produced.
. * No -booktabs- option -> plain \hline rules, matching the book's table style.
. local frag "ch11_wage_table.tex"

. * Step 1: -esttab- writes the table body (rows only) with -fragment-.
. * Force a .tex target so esttab emits LaTeX, not fixed-format text.
. local body "$output/ch11_wage_body.tex"

. esttab m1 m2 using "`body'", replace fragment ///
>     label collabels(none) nonotes nostar ///
>     b(%9.1f) se(%9.1f) ///
>     stats(N r2, fmt(%9.0fc %9.3f) ///
>         labels("Participants" "R-squared")) ///
>     order(hours exper female) ///
>     varlabels(_cons Constant) ///
>     mtitle("Dose only" "Dose + controls")
(output written to /Users/ericbooth/Library/CloudStorage/GoogleDrive-eric.booth@texas2036.
> org/My Drive/Book-Manuscript-Applied-Evaluation-Stata/code/output/ch11_wage_body.tex)

. 
. * Step 2: wrap that body in a complete, self-contained -tabular- with
. * plain \hline rules, so the book -\input-s one ready-to-typeset file.
. tempname fh fb

. file open `fh' using "$output/`frag'", write replace text

. file write `fh' "% ch11_wage_table.tex" _n

. file write `fh' "% Generated by ch11_tables.do -- do not edit by hand." _n

. file write `fh' "\begin{tabular}{l*{2}{c}}" _n

. file write `fh' "\hline\hline" _n

. file open `fb' using "`body'", read text

. file read `fb' line

. while r(eof) == 0 {
  2.     file write `fh' `"`line'"' _n
  3.     file read `fb' line
  4. }

. file close `fb'

. file write `fh' "\hline\hline" _n

. file write `fh' "\end{tabular}" _n

. file close `fh'

. 
. di "---FRAGMENT WRITTEN---"
---FRAGMENT WRITTEN---

. type "$output/`frag'"
