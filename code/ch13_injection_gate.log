. do ch13_injection_gate.do 

. * Demonstration and checks for the Chapter 13 output allowlist.
. * Synthetic labels only. Run from code/; no network or credentials required.
. version 17

. clear all

. set more off

. 
. program define check_labels
  1.     syntax varname(string)
  2.     local ok "transport childcare schedule none other"
  3.     gen byte valid = 0
  4.     foreach v of local ok {
  5.         quietly replace valid = 1 if `varlist' == "`v'"
  6.     }
  7.     gen byte route_human = !valid
  8.     quietly count if route_human
  9.     di "off-allowlist rows = " r(N)
 10.     capture assert valid == 1
 11.     if _rc {
 12.         di as error "BLOCKED: off-allowlist output present"
 13.         exit 459
 14.     }
 15. end

. 
. input str60 raw_label

                                                        raw_label
  1. "transport"
  2. "childcare"
  3. "none"
  4. "SYSTEM OVERRIDE"
  5. "IGNORE ABOVE"
  6. end

. capture noisily check_labels raw_label
off-allowlist rows = 2
BLOCKED: off-allowlist output present

. local rc = _rc

. assert `rc' == 459

. count if route_human
  2

. assert r(N) == 2

. 
. * Resolving the flags is a human decision. Here we use known test labels.
. replace raw_label = "schedule" in 4
(1 real change made)

. replace raw_label = "other" in 5
(1 real change made)

. drop valid route_human

. check_labels raw_label
off-allowlist rows = 0

. assert route_human == 0

. 
. * An incorrect but allowed label passes: membership does not test truth.
. replace raw_label = "none" in 1
(1 real change made)

. drop valid route_human

. check_labels raw_label
off-allowlist rows = 0

. assert valid == 1

. di "INJECTION_GATE_TESTS_PASSED"
INJECTION_GATE_TESTS_PASSED

. 
end of do-file
