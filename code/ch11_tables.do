*==============================================================================*
* ch11_tables.do  --  Chapter 11: delivering through spreadsheets
* The reproducible-reporting thesis made physical:
*   (a) simulate a workforce program's participant earnings dataset,
*   (b) estimate a simple earnings model by cohort,
*   (c) write a booktabs-FREE LaTeX table fragment with -esttab-,
*       which the book -\input-s directly (no hand editing), and
*   (d) show the -putexcel- path that ships the same table to Excel.
* The earnings data are SIMULATED with seed 20260704 (labeled so in text).
*==============================================================================*
* Globals defined locally so this file runs standalone; in the full book
* project they are set once by code/00_control.do instead.
global root    "`c(pwd)'"
global raw     "$root/raw"
global clean   "$root/clean"
global output  "$root/output"
global figures "$root/figures"
capture mkdir "$raw"
capture mkdir "$clean"
capture mkdir "$output"
capture mkdir "$figures"

version 18
clear all
set more off
set linesize 90

*--- (a) Simulate a workforce program's participant earnings ------------------*
* 900 participants across three enrollment cohorts. Post-program quarterly
* earnings rise with a training-hours dose and with prior work experience.
set seed 20260704
set obs 900
gen id       = _n
gen cohort   = 1 + mod(_n, 3)            // cohorts 1, 2, 3 (roughly equal)
label define coh 1 "2022 cohort" 2 "2023 cohort" 3 "2024 cohort"
label values cohort coh

gen female   = runiform() < 0.54
gen exper    = max(0, round(rnormal(6, 4)))      // years of prior work
gen hours    = round(20 + 60*runiform())         // training hours 20-80

* True data-generating process (dollars per quarter):
gen earn = 3800 + 22*hours + 140*exper - 260*female ///
           + 300*(cohort==2) + 640*(cohort==3) + rnormal(0, 900)
replace earn = round(earn)
label var earn   "Quarterly earnings ($)"
label var hours  "Training hours"
label var exper  "Prior experience (yrs)"
label var female "Female"

save "$clean/ch11_earnings.dta", replace

*--- (b) Two nested models: raw dose, then dose plus controls -----------------*
eststo clear
eststo m1: regress earn hours
eststo m2: regress earn hours exper female i.cohort

di "---MODEL 2 KEY COEFFICIENTS---"
esttab m2, se b(%9.1f) se(%9.1f) nostar noobs ///
    keep(hours exper female)

*--- (c) Write a booktabs-FREE LaTeX fragment the book -\input-s --------------*
* -esttab- writes the .tex; the book ingests exactly what this line produced.
* No -booktabs- option -> plain \hline rules, matching the book's table style.
local frag "ch11_wage_table.tex"
* Step 1: -esttab- writes the table body (rows only) with -fragment-.
* Force a .tex target so esttab emits LaTeX, not fixed-format text.
local body "$output/ch11_wage_body.tex"
esttab m1 m2 using "`body'", replace fragment ///
    label collabels(none) nonotes nostar ///
    b(%9.1f) se(%9.1f) ///
    stats(N r2, fmt(%9.0fc %9.3f) ///
        labels("Participants" "R-squared")) ///
    order(hours exper female) ///
    varlabels(_cons Constant) ///
    mtitle("Dose only" "Dose + controls")

* Step 2: wrap that body in a complete, self-contained -tabular- with
* plain \hline rules, so the book -\input-s one ready-to-typeset file.
tempname fh fb
file open `fh' using "$output/`frag'", write replace text
file write `fh' "% ch11_wage_table.tex" _n
file write `fh' "% Generated by ch11_tables.do -- do not edit by hand." _n
file write `fh' "\begin{tabular}{l*{2}{c}}" _n
file write `fh' "\hline\hline" _n
file open `fb' using "`body'", read text
file read `fb' line
while r(eof) == 0 {
    file write `fh' `"`line'"' _n
    file read `fb' line
}
file close `fb'
file write `fh' "\hline\hline" _n
file write `fh' "\end{tabular}" _n
file close `fh'

di "---FRAGMENT WRITTEN---"
type "$output/`frag'"

*--- (d) The same numbers, shipped to Excel with -putexcel- (display path) ----*
* This block writes a formatted one-tab workbook a funder opens in Excel.
* Shown for reference; the .xlsx is a delivery artifact, not a book input.
putexcel set "$output/ch11_earnings_summary.xlsx", replace
putexcel A1 = "Program earnings model (simulated)", bold
putexcel A2 = "Term"        B2 = "Dose only"  C2 = "Dose + controls", bold
putexcel A3 = "Training hours ($/hr equiv)"
putexcel B3 = (_b[hours])   C3 = (0)     // filled from stored estimates
putexcel A4 = "Participants"
putexcel B4 = (e(N))
putexcel save

di "DONE"
