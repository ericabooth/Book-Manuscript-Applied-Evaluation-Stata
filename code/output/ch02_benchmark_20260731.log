. *--- Build a 2-million-row file from a shipped dataset ----------------------
> --*
. sysuse nlsw88, clear
(NLSW, 1988 extract)

. expand 891                       // 2,246 x 891 = 2,001,186 rows
(1,998,940 observations created)

. gen long gid = mod(_n, 200000)   // a 200,000-group identifier

. di as txt "Rows in memory: " as res %12.0fc _N
Rows in memory:    2,001,186

. 
. *--- Benchmarks 1-2: collapse vs gcollapse at 24 and 200k groups ------------
> ---*
. * preserve/restore sits OUTSIDE the timers, so we time only the command.
. timer clear

. forvalues i = 1/5 {
  2.     preserve
  3.     timer on 1
  4.     collapse (mean) wage hours, by(industry union)
  5.     timer off 1
  6.     restore
  7. 
.     preserve
  8.     timer on 2
  9.     gcollapse (mean) wage hours, by(industry union)
 10.     timer off 2
 11.     restore
 12. 
.     preserve
 13.     timer on 3
 14.     collapse (mean) wage hours, by(gid)
 15.     timer off 3
 16.     restore
 17. 
.     preserve
 18.     timer on 4
 19.     gcollapse (mean) wage hours, by(gid)
 20.     timer off 4
 21.     restore
 22. }

. 
. *--- Benchmarks 3-4: egen vs gegen, group means back onto the rows ----------
> ---*
. forvalues i = 1/5 {
  2.     timer on 5
  3.     egen m24_`i' = mean(wage), by(industry union)
  4.     timer off 5
  5. 
.     timer on 6
  6.     gegen g24_`i' = mean(wage), by(industry union)
  7.     timer off 6
  8. 
.     timer on 7
  9.     egen m2k_`i' = mean(wage), by(gid)
 10.     timer off 7
 11. 
.     timer on 8
 12.     gegen g2k_`i' = mean(wage), by(gid)
 13.     timer off 8
 14. 
.     assert abs(m24_`i' - g24_`i') < 1e-6   // same answer, or no deal
 15.     assert abs(m2k_`i' - g2k_`i') < 1e-6
 16.     drop m24_`i' g24_`i' m2k_`i' g2k_`i'
 17. }

. 
