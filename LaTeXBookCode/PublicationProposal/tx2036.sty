% ===========================================================================
%  tx2036.sty — Texas 2036 Data & Research brand style (XeLaTeX)
%  Build with:  latexmk -xelatex <file>.tex   (or xelatex twice)
%  Brand tokens mirror the team's webdoc2 header.html + 050_preferences.do.
% ===========================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tx2036}[2026/06/01 Texas 2036 Data & Research brand]

% ---- Core packages --------------------------------------------------------
\RequirePackage{geometry}
\RequirePackage{fontspec}
\RequirePackage[table]{xcolor}
\RequirePackage{graphicx}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{ragged2e}
\RequirePackage{longtable}
% fontawesome5 supplies callout-box icons; degrade gracefully where the
% package is unavailable (e.g., minimal TeX Live installs) so the document
% still builds -- boxes then render with text-only titles.
\IfFileExists{fontawesome5.sty}{\RequirePackage{fontawesome5}}{%
  \providecommand{\faInfoCircle}{\textbf{i}}%
  \providecommand{\faLightbulb}{}%
  \providecommand{\faExclamationTriangle}{\textbf{!}}%
  \providecommand{\faGavel}{}%
  \providecommand{\faFolderOpen}{}%
}
\RequirePackage{needspace}
\RequirePackage[most]{tcolorbox}
\RequirePackage{tikz}
\usetikzlibrary{positioning,arrows.meta,shapes.geometric,calc,fit,backgrounds,shadows.blur}

% ---- Brand palette --------------------------------------------------------
\definecolor{txnavy}{HTML}{1B2D55}
\definecolor{txorange}{HTML}{D44500}
\definecolor{txlink}{HTML}{2B6CB0}
\definecolor{txlightbg}{HTML}{F5F7FA}
\definecolor{txmuted}{HTML}{6C7A8D}
\definecolor{txborder}{HTML}{DEE2E6}
\definecolor{txtext}{HTML}{1A1A2E}
\definecolor{txgreen}{HTML}{28A745}
\definecolor{txgold}{HTML}{FFC107}
\definecolor{txred}{HTML}{C0392B}

% ---- Fonts -----------------------------------------------------------------
% Probing for fonts that are absent (e.g., Menlo on Linux) must not abort the
% build: make missing-font lookups non-fatal before any \IfFontExistsTF.
\ifdefined\suppressfontnotfounderror\suppressfontnotfounderror=1\fi
% Brand font: Montserrat, preferring the copy bundled with the project
% (../fonts/ relative to report/, OFL license included) so documents render
% identically anywhere. Chain: bundled Montserrat -> system Montserrat ->
% Inter -> Helvetica Neue -> TeX Gyre Heros (TeX Live Helvetica clone).
\IfFileExists{../fonts/Montserrat-Regular.ttf}{%
  \setsansfont{Montserrat-Regular.ttf}[Path=../fonts/,
    BoldFont=Montserrat-Bold.ttf, ItalicFont=Montserrat-Italic.ttf,
    BoldItalicFont=Montserrat-BoldItalic.ttf]%
}{%
  \IfFontExistsTF{Montserrat}{\setsansfont{Montserrat}}{%
    \IfFontExistsTF{Inter}{\setsansfont{Inter}[Numbers=Lining]}{%
      \IfFontExistsTF{Helvetica Neue}{\setsansfont{Helvetica Neue}}{\setsansfont{TeX Gyre Heros}}}}%
}
\IfFontExistsTF{Menlo}{\setmonofont{Menlo}[Scale=0.86]}{%
  \IfFontExistsTF{Courier New}{\setmonofont{Courier New}[Scale=0.9]}{\setmonofont{TeX Gyre Cursor}[Scale=0.9]}}
\renewcommand{\familydefault}{\sfdefault}
\color{txtext}

% ---- Page geometry --------------------------------------------------------
\geometry{letterpaper, top=1.05in, bottom=1.0in, left=1.05in, right=1.05in,
          headheight=22pt, headsep=16pt, footskip=30pt}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em}
\linespread{1.06}

% ---- Hyperlinks (loaded late) ---------------------------------------------
\RequirePackage[hidelinks]{hyperref}
\hypersetup{colorlinks=true, linkcolor=txnavy, urlcolor=txlink, citecolor=txlink,
            pdftitle={Texas 2036 Data Governance Guide}, pdfauthor={Texas 2036 Data \& Research}}

% ---- Headings -------------------------------------------------------------
\titleformat{\section}[block]
  {\sffamily\LARGE\bfseries\color{txnavy}}{\thesection}{0.6em}{}
  [{\vspace{-0.35em}\color{txorange}\titlerule[2.4pt]}]
\titleformat{\subsection}
  {\sffamily\large\bfseries\color{txnavy}}{\thesubsection}{0.5em}{}
\titleformat{\subsubsection}
  {\sffamily\normalsize\bfseries\color{txorange}}{}{0em}{}
\titlespacing*{\section}{0pt}{1.4em}{0.7em}
\titlespacing*{\subsection}{0pt}{1.1em}{0.4em}
\titlespacing*{\subsubsection}{0pt}{0.8em}{0.2em}

% Keep headings from being orphaned at the foot of a page: require enough room
% below a section/subsection, else break to the next page. \subsectionbreak is a
% titlesec hook, safe to set without touching \subsection's starred form.
\def\sectionbreak{\needspace{7\baselineskip}}
\def\subsectionbreak{\needspace{4\baselineskip}}

% ---- Header / footer ------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.8pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{txorange}\leaders\hrule height \headrulewidth\hfill}}
\fancyhead[L]{\footnotesize\color{txmuted} Active Projects Guide}
\fancyhead[R]{\footnotesize\color{txmuted} Texas 2036 \textbullet\ Data \& Research}
\fancyfoot[C]{\footnotesize\color{txmuted}\thepage}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\footnotesize\color{txmuted}\thepage}}

% ---- Lists ----------------------------------------------------------------
\setlist[itemize]{leftmargin=1.3em, itemsep=2pt, topsep=2pt, label={\color{txorange}\small\textbullet}}
\setlist[enumerate]{leftmargin=1.5em, itemsep=2pt, topsep=2pt, label={\color{txnavy}\bfseries\arabic*.}}

% ---- Callout boxes --------------------------------------------------------
\newtcolorbox{txnote}[1][Note]{enhanced, breakable, colback=txlightbg, colframe=txnavy,
  colbacktitle=txlightbg, boxrule=0pt, leftrule=3pt, arc=2pt,
  left=10pt, right=10pt, top=7pt, bottom=7pt,
  fonttitle=\bfseries\sffamily, coltitle=txnavy,
  title={\faInfoCircle\ \ #1}, titlerule=0pt, toptitle=3pt, bottomtitle=0pt}

\newtcolorbox{txtip}[1][Tip]{enhanced, breakable, colback=txgreen!6, colframe=txgreen,
  colbacktitle=txgreen!6, boxrule=0pt, leftrule=3pt, arc=2pt,
  left=10pt, right=10pt, top=7pt, bottom=7pt,
  fonttitle=\bfseries\sffamily, coltitle=txgreen!50!black,
  title={\faLightbulb\ \ #1}, titlerule=0pt, toptitle=3pt, bottomtitle=0pt}

\newtcolorbox{txwarn}[1][Watch out]{enhanced, breakable, colback=txorange!7, colframe=txorange,
  colbacktitle=txorange!7, boxrule=0pt, leftrule=3pt, arc=2pt,
  left=10pt, right=10pt, top=7pt, bottom=7pt,
  fonttitle=\bfseries\sffamily, coltitle=txorange!85!black,
  title={\faExclamationTriangle\ \ #1}, titlerule=0pt, toptitle=3pt, bottomtitle=0pt}

\newtcolorbox{txrule}[1][Policy]{enhanced, breakable, colback=white, colframe=txnavy,
  boxrule=1pt, arc=2pt, left=10pt, right=10pt, top=7pt, bottom=7pt,
  fonttitle=\bfseries\sffamily\color{white}, coltitle=white,
  colbacktitle=txnavy, title={\faGavel\ \ #1}}

% ---- Inline code ----------------------------------------------------------
\newcommand{\code}[1]{{\small\ttfamily\colorbox{txlightbg}{\textcolor{txnavy}{\strut #1}}}}
\newcommand{\folder}[1]{\textcolor{txnavy}{\faFolderOpen\,\textbf{#1}}}

% ---- Tables: a nicer default ----------------------------------------------
\renewcommand{\arraystretch}{1.3}
\newcommand{\thd}[1]{\textcolor{white}{\bfseries #1}}        % table header text
\newcommand{\headrowcolor}{\rowcolor{txnavy}}
% Vertically centre every wrapping cell (tabularx X columns use m, not p):
\renewcommand{\tabularxcolumn}[1]{>{\arraybackslash}m{#1}}
% Reusable, vertically-centred column types (widths in the arg):
\newcolumntype{L}[1]{>{\bfseries\color{txnavy}\RaggedRight\arraybackslash}m{#1}} % bold navy label column
\newcolumntype{P}[1]{>{\RaggedRight\arraybackslash}m{#1}}    % left-aligned wrapping text
\newcolumntype{C}[1]{>{\centering\arraybackslash}m{#1}}      % centred wrapping text
\newcommand{\zebra}{\rowcolors{2}{txlightbg}{white}}         % alternate-row shading (start row 2)

 
 
 

% Step badge for numbered workflows (used in quickstart)
\newcommand{\stepbadge}[1]{\tikz[baseline=(b.base)]{\node[circle, fill=txorange, text=white,
  font=\sffamily\bfseries\small, inner sep=2.2pt, minimum size=1.6em] (b) {#1};}}

\endinput
