\contentsline {subsection}{\numberline {13.1.7}Going parallel without losing the log: two worked patterns}{254}{subsection.13.1.7}%
\contentsline {paragraph}{\nonumberline Pattern 1: split a slow estimation across instances.}{254}{paragraph*.155}%
\contentsline {paragraph}{\nonumberline Pattern 2: fan out the code review.}{254}{paragraph*.157}%
\contentsline {subsection}{\numberline {13.1.8}Testing for the machines you do not have}{255}{subsection.13.1.8}%
\contentsline {paragraph}{\nonumberline Ask for the inventory before the tests.}{256}{paragraph*.159}%
\contentsline {paragraph}{\nonumberline Turn each item into a test that stops on failure.}{256}{paragraph*.161}%
\contentsline {paragraph}{\nonumberline Run the tests under every environment you can reach.}{256}{paragraph*.163}%
\contentsline {paragraph}{\nonumberline Review twice, with different methods, and try to refute each finding.}{257}{paragraph*.165}%
\contentsline {paragraph}{\nonumberline Name what you could not test.}{257}{paragraph*.167}%
\contentsline {paragraph}{\nonumberline What the loop gives you so far.}{257}{paragraph*.169}%
\contentsline {section}{\numberline {13.2}An evidence ledger for every number and reference}{258}{section.13.2}%
\contentsline {paragraph}{\nonumberline The analysis saves what it will report.}{258}{paragraph*.171}%
\contentsline {paragraph}{\nonumberline The ledger states each number as the prose does.}{258}{paragraph*.173}%
\contentsline {paragraph}{\nonumberline Let the document read its numbers from Stata.}{259}{paragraph*.175}%
\contentsline {paragraph}{\nonumberline Check each reference against its record.}{259}{paragraph*.177}%
\contentsline {paragraph}{\nonumberline When the ledger runs.}{259}{paragraph*.179}%
\contentsline {section}{\numberline {13.3}The assistant as a thought partner}{259}{section.13.3}%
\contentsline {paragraph}{\nonumberline Plan before the first do-file.}{260}{paragraph*.181}%
\contentsline {paragraph}{\nonumberline Ask for the alternatives you would rather not run.}{260}{paragraph*.183}%
\contentsline {paragraph}{\nonumberline Read inherited code with a check.}{260}{paragraph*.185}%
\contentsline {paragraph}{\nonumberline Translate, then compare the outputs.}{260}{paragraph*.187}%
\contentsline {paragraph}{\nonumberline Write the tests and the help file before the command.}{260}{paragraph*.189}%
\contentsline {paragraph}{\nonumberline What the assistant adds.}{261}{paragraph*.191}%
