\contentsline {paragraph}{\nonumberline Two more files the assistant reads first.}{251}{paragraph*.153}%
\contentsline {subsection}{\numberline {13.1.4}Step 2: scaffold the project and its documentation layer}{252}{subsection.13.1.4}%
\contentsline {subsection}{\numberline {13.1.5}Step 3: the propose, run, verify loop with tripwires}{252}{subsection.13.1.5}%
